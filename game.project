[project]
title = "Rift Vector"
version = "0.1.0"
dependencies#0 = https://github.com/britzl/deftest/archive/refs/heads/master.zip
custom_resources = /main/game.appmanifest,/assets/sprites/manifest.json,/assets/audio/audio_manifest.json

[bootstrap]
main_collection = /main/main.collectionc
render = /main/game.renderc

[input]
game_binding = /main/game.input_bindingc

[display]
width = 960
height = 600

[physics]
scale = 0.01
gravity_y = -1000.0
velocity_threshold = 100.0
use_fixed_timestep = 1

[engine]
fixed_update_frequency = 60

[html5]
scale_mode = Fit
heap_size = 64
retry_count = 1000

[script]
shared_state = 1

[native_extension]
app_manifest = /main/game.appmanifest

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[sprite]
subpixels = 0
max_count = 512

[factory]
max_count = 64

[collection]
max_instances = 1024

[sound]
max_sound_instances = 64
use_linear_gain = 1
max_component_count = 64
max_sound_sources = 32
